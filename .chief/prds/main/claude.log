{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jz8NSV8GRWNEjRxVyghNy3","type":"tool_result","content":"     1→/* eslint-disable no-console */\n     2→const { app, BrowserWindow } = require('electron')\n     3→const path = require('path')\n     4→const { autoUpdater } = require('electron-updater')\n     5→const { registerProjectHandlers } = require('./handlers/projectHandlers')\n     6→const { registerNginxHandlers } = require('./handlers/nginxHandlers')\n     7→const { registerToolsHandlers } = require('./handlers/toolsHandlers')\n     8→const { registerSystemHandlers } = require('./handlers/systemHandlers')\n     9→\n    10→let mainWindow\n    11→\n    12→function createWindow() {\n    13→  mainWindow = new BrowserWindow({\n    14→    width: 1200,\n    15→    height: 800,\n    16→    icon: path.join(__dirname, '../renderer/src/assets/icons/icon.png'),\n    17→    webPreferences: {\n    18→      nodeIntegration: true,\n    19→      contextIsolation: false,\n    20→      // devTools: false,\n    21→    },\n    22→    autoHideMenuBar: true,\n    23→    fullscreen: false,\n    24→    resizable: false,\n    25→    maximizable: false,\n    26→    fullscreenable: false,\n    27→  })\n    28→\n    29→  if (process.env.NODE_ENV === 'development') {\n    30→    mainWindow.loadURL('http://localhost:5173')\n    31→    mainWindow.webContents.openDevTools()\n    32→  } else {\n    33→    mainWindow.loadFile(path.join(__dirname, '../renderer/dist/index.html'))\n    34→  }\n    35→}\n    36→\n    37→function setupAutoUpdater() {\n    38→  autoUpdater.autoDownload = false\n    39→  autoUpdater.autoInstallOnAppQuit = true\n    40→\n    41→  if (process.env.NODE_ENV !== 'development') {\n    42→    autoUpdater.checkForUpdates()\n    43→  }\n    44→\n    45→  autoUpdater.on('update-available', (info) => {\n    46→    mainWindow.webContents.send('update-available', info)\n    47→  })\n    48→\n    49→  autoUpdater.on('update-not-available', (info) => {\n    50→    mainWindow.webContents.send('update-not-available', info)\n    51→  })\n    52→\n    53→  autoUpdater.on('download-progress', (progressObj) => {\n    54→    mainWindow.webContents.send('download-progress', progressObj)\n    55→  })\n    56→\n    57→  autoUpdater.on('update-downloaded', (info) => {\n    58→    mainWindow.webContents.send('update-downloaded', info)\n    59→  })\n    60→\n    61→  autoUpdater.on('error', (err) => {\n    62→    mainWindow.webContents.send('update-error', err)\n    63→  })\n    64→}\n    65→\n    66→app.whenReady().then(() => {\n    67→  createWindow()\n    68→  setupAutoUpdater()\n    69→\n    70→  registerProjectHandlers(mainWindow)\n    71→  registerNginxHandlers()\n    72→  registerToolsHandlers()\n    73→  registerSystemHandlers(mainWindow)\n    74→})\n    75→\n    76→app.on('window-all-closed', () => {\n    77→  if (process.platform !== 'darwin') {\n    78→    app.quit()\n    79→  }\n    80→})\n    81→\n    82→app.on('activate', () => {\n    83→  if (BrowserWindow.getAllWindows().length === 0) {\n    84→    createWindow()\n    85→  }\n    86→})\n    87→"}]},"parent_tool_use_id":null,"session_id":"651ef616-8f53-4934-8a10-e1ac3723bfe7","uuid":"177dcf78-a339-49ce-b31c-ef97ef02ed94","tool_use_result":{"type":"text","file":{"filePath":"/home/h-mab/learn/localforge/src/main/main.js","content":"/* eslint-disable no-console */\nconst { app, BrowserWindow } = require('electron')\nconst path = require('path')\nconst { autoUpdater } = require('electron-updater')\nconst { registerProjectHandlers } = require('./handlers/projectHandlers')\nconst { registerNginxHandlers } = require('./handlers/nginxHandlers')\nconst { registerToolsHandlers } = require('./handlers/toolsHandlers')\nconst { registerSystemHandlers } = require('./handlers/systemHandlers')\n\nlet mainWindow\n\nfunction createWindow() {\n  mainWindow = new BrowserWindow({\n    width: 1200,\n    height: 800,\n    icon: path.join(__dirname, '../renderer/src/assets/icons/icon.png'),\n    webPreferences: {\n      nodeIntegration: true,\n      contextIsolation: false,\n      // devTools: false,\n    },\n    autoHideMenuBar: true,\n    fullscreen: false,\n    resizable: false,\n    maximizable: false,\n    fullscreenable: false,\n  })\n\n  if (process.env.NODE_ENV === 'development') {\n    mainWindow.loadURL('http://localhost:5173')\n    mainWindow.webContents.openDevTools()\n  } else {\n    mainWindow.loadFile(path.join(__dirname, '../renderer/dist/index.html'))\n  }\n}\n\nfunction setupAutoUpdater() {\n  autoUpdater.autoDownload = false\n  autoUpdater.autoInstallOnAppQuit = true\n\n  if (process.env.NODE_ENV !== 'development') {\n    autoUpdater.checkForUpdates()\n  }\n\n  autoUpdater.on('update-available', (info) => {\n    mainWindow.webContents.send('update-available', info)\n  })\n\n  autoUpdater.on('update-not-available', (info) => {\n    mainWindow.webContents.send('update-not-available', info)\n  })\n\n  autoUpdater.on('download-progress', (progressObj) => {\n    mainWindow.webContents.send('download-progress', progressObj)\n  })\n\n  autoUpdater.on('update-downloaded', (info) => {\n    mainWindow.webContents.send('update-downloaded', info)\n  })\n\n  autoUpdater.on('error', (err) => {\n    mainWindow.webContents.send('update-error', err)\n  })\n}\n\napp.whenReady().then(() => {\n  createWindow()\n  setupAutoUpdater()\n\n  registerProjectHandlers(mainWindow)\n  registerNginxHandlers()\n  registerToolsHandlers()\n  registerSystemHandlers(mainWindow)\n})\n\napp.on('window-all-closed', () => {\n  if (process.platform !== 'darwin') {\n    app.quit()\n  }\n})\n\napp.on('activate', () => {\n  if (BrowserWindow.getAllWindows().length === 0) {\n    createWindow()\n  }\n})\n","numLines":87,"startLine":1,"totalLines":87}}}
