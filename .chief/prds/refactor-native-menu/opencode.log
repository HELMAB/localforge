ms/tool-sections/MysqlSection.vue'\n\nconst {\n  installedTools,\n  checkInstalledTools,\n  installPHP,\n  installPHPExtensions,\n  installNode,\n  setDefaultNode,\n  uninstallNode,\n  installNginx,\n  installComposer,\n  installPostgreSQL,\n  installMySQL,\n} = useTools()\n\nconst { menuActiveView, clearMenuActiveView } = useMenuNavigation()\nconst selectedTool = ref('php')\n\nwatch(menuActiveView, (newView) => {\n  if (['php', 'composer', 'node', 'nginx', 'postgresql', 'mysql'].includes(newView)) {\n    selectedTool.value = newView === 'node' ? 'node' : newView\n    clearMenuActiveView()\n  }\n})\n\nonMounted(() => {\n  checkInstalledTools()\n  if (menuActiveView.value) {\n    selectedTool.value = menuActiveView.value === 'node' ? 'node' : menuActiveView.value\n    clearMenuActiveView()\n  }\n})\n</script>\n","additions":14,"deletions":1},"truncated":false},"time":{"start":1773232319375,"end":1773232322933}}}}
