{"type":"tool_use","timestamp":1773232987423,"sessionID":"ses_32317be04ffe8ft96uo11uAfzd","part":{"id":"prt_cdcec1cf7001slrdo5bqvhXqHh","sessionID":"ses_32317be04ffe8ft96uo11uAfzd","messageID":"msg_cdcec126c001OnG9ZY5Rf6TZYd","type":"tool","callID":"call_function_zcu9krfy3eg2_1","tool":"read","state":{"status":"completed","input":{"filePath":"/home/h-mab/learn/localforge/src/renderer/src/composables/useUpdater.js"},"output":"<path>/home/h-mab/learn/localforge/src/renderer/src/composables/useUpdater.js</path>\n<type>file</type>\n<content>1: import { ref } from 'vue'\n2: import { useIpc } from './useIpc'\n3: \n4: const { ipcRenderer } = window.require('electron')\n5: \n6: const updateAvailable = ref(false)\n7: const updateInfo = ref(null)\n8: const downloadProgress = ref(null)\n9: const updateDownloaded = ref(false)\n10: const updateError = ref(null)\n11: const checking = ref(false)\n12: const downloading = ref(false)\n13: \n14: // Event handlers\n15: const handleUpdateAvailable = (event, info) => {\n16:   updateAvailable.value = true\n17:   updateInfo.value = info\n18: }\n19: \n20: const handleUpdateNotAvailable = (event, info) => {\n21:   updateAvailable.value = false\n22:   updateInfo.value = info\n23:   checking.value = false\n24: }\n25: \n26: const handleDownloadProgress = (event, progress) => {\n27:   downloadProgress.value = progress\n28: }\n29: \n30: const handleUpdateDownloaded = (event, info) => {\n31:   updateDownloaded.value = true\n32:   updateInfo.value = info\n33:   downloading.value = false\n34: }\n35: \n36: const handleUpdateError = (event, error) => {\n37:   updateError.value = error.message\n38:   checking.value = false\n39:   downloading.value = false\n40: }\n41: \n42: // Register event listeners once\n43: ipcRenderer.on('update-available', handleUpdateAvailable)\n44: ipcRenderer.on('update-not-available', handleUpdateNotAvailable)\n45: ipcRenderer.on('download-progress', handleDownloadProgress)\n46: ipcRenderer.on('update-downloaded', handleUpdateDownloaded)\n47: ipcRenderer.on('update-error', handleUpdateError)\n48: \n49: export function useUpdater() {\n50:   const { invoke } = useIpc()\n51: \n52:   const checkForUpdates = async () => {\n53:     checking.value = true\n54:     updateError.value = null\n55:     try {\n56:       await invoke('check-for-updates')\n57:     } catch (error) {\n58:       updateError.value = error.message\n59:       checking.value = false\n60:     }\n61:   }\n62: \n63:   const downloadUpdate = async () => {\n64:     downloading.value = true\n65:     updateError.value = null\n66:     try {\n67:       await invoke('download-update')\n68:     } catch (error) {\n69:       updateError.value = error.message\n70:       downloading.value = false\n71:     }\n72:   }\n73: \n74:   const installUpdate = async () => {\n75:     try {\n76:       await invoke('install-update')\n77:     } catch (error) {\n78:       updateError.value = error.message\n79:     }\n80:   }\n81: \n82:   return {\n83:     updateAvailable,\n84:     updateInfo,\n85:     downloadProgress,\n86:     updateDownloaded,\n87:     updateError,\n88:     checking,\n89:     downloading,\n90:     checkForUpdates,\n91:     downloadUpdate,\n92:     installUpdate,\n93:   }\n94: }\n\n(End of file - total 94 lines)\n</content>","title":"src/renderer/src/composables/useUpdater.js","metadata":{"preview":"import { ref } from 'vue'\nimport { useIpc } from './useIpc'\n\nconst { ipcRenderer } = window.require('electron')\n\nconst updateAvailable = ref(false)\nconst updateInfo = ref(null)\nconst downloadProgress = ref(null)\nconst updateDownloaded = ref(false)\nconst updateError = ref(null)\nconst checking = ref(false)\nconst downloading = ref(false)\n\n// Event handlers\nconst handleUpdateAvailable = (event, info) => {\n  updateAvailable.value = true\n  updateInfo.value = info\n}\n\nconst handleUpdateNotAvailable = (event, info) => {","truncated":false,"loaded":[]},"time":{"start":1773232987394,"end":1773232987420}}}}
