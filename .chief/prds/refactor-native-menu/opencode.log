\n42:     autoUpdater.checkForUpdates()\n43:   }\n44: \n45:   autoUpdater.on('update-available', (info) => {\n46:     mainWindow.webContents.send('update-available', info)\n47:   })\n48: \n49:   autoUpdater.on('update-not-available', (info) => {\n50:     mainWindow.webContents.send('update-not-available', info)\n51:   })\n52: \n53:   autoUpdater.on('download-progress', (progressObj) => {\n54:     mainWindow.webContents.send('download-progress', progressObj)\n55:   })\n56: \n57:   autoUpdater.on('update-downloaded', (info) => {\n58:     mainWindow.webContents.send('update-downloaded', info)\n59:   })\n60: \n61:   autoUpdater.on('error', (err) => {\n62:     mainWindow.webContents.send('update-error', err)\n63:   })\n64: }\n65: \n66: app.whenReady().then(() => {\n67:   createWindow()\n68:   buildMenu(mainWindow)\n69:   setupAutoUpdater()\n70: \n71:   ipcMain.on('dark-mode-changed', (_event, newIsDark) => {\n72:     rebuildMenu(mainWindow, { isDark: newIsDark })\n73:   })\n74: \n75:   ipcMain.on('language-changed', (_event, newLanguage) => {\n76:     rebuildMenu(mainWindow, { language: newLanguage })\n77:   })\n78: \n79:   registerProjectHandlers(mainWindow)\n80:   registerNginxHandlers()\n81:   registerToolsHandlers()\n82:   registerSystemHandlers(mainWindow)\n83: })\n84: \n85: app.on('window-all-closed', () => {\n86:   if (process.platform !== 'darwin') {\n87:     app.quit()\n88:   }\n89: })\n90: \n91: app.on('activate', () => {\n92:   if (BrowserWindow.getAllWindows().length === 0) {\n93:     createWindow()\n94:   }\n95: })\n\n(End of file - total 95 lines)\n</content>","title":"src/main/main.js","metadata":{"preview":"/* eslint-disable no-console */\nconst { app, BrowserWindow, ipcMain } = require('electron')\nconst path = require('path')\nconst { autoUpdater } = require('electron-updater')\nconst { registerProjectHandlers } = require('./handlers/projectHandlers')\nconst { registerNginxHandlers } = require('./handlers/nginxHandlers')\nconst { registerToolsHandlers }