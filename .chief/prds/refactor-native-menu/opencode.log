er-t border-gray-200 dark:border-gray-700\" />\n39: \n40:       <!-- Dark Mode -->\n41:       <div class=\"flex items-center justify-between\">\n42:         <div class=\"flex items-center gap-3\">\n43:           <div\n44:             class=\"w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-900/20 flex items-center justify-center\"\n45:           >\n46:             <Moon v-if=\"!isDark\" class=\"w-5 h-5 text-purple-600 dark:text-purple-400\" />\n47:             <Sun v-else class=\"w-5 h-5 text-purple-600 dark:text-purple-400\" />\n48:           </div>\n49:           <div>\n50:             <Label class=\"text-sm font-semibold text-gray-700 dark:text-gray-300\">\n51:               {{ t('darkModeLabel') }}\n52:             </Label>\n53:             <p class=\"text-xs text-gray-500 dark:text-gray-400\">\n54:               {{ isDark ? t('darkThemeEnabled') : t('lightThemeEnabled') }}\n55:             </p>\n56:           </div>\n57:         </div>\n58:         <Switch :model-value=\"isDark\" @update:model-value=\"toggleDarkMode\" />\n59:       </div>\n60: \n61:       <div class=\"border-t border-gray-200 dark:border-gray-700\" />\n62: \n63:       <!-- Default Path -->\n64:       <div>\n65:         <div class=\"flex items-center gap-3 mb-2\">\n66:           <div\n67:             class=\"w-10 h-10 rounded-lg bg-green-50 dark:bg-green-900/20 flex items-center justify-center\"\n68:           >\n69:             <Folder class=\"w-5 h-5 text-green-600 dark:text-green-400\" />\n70:           </div>\n71:           <div>\n72:             <Label class=\"text-sm font-semibold text-gray-700 dark:text-gray-300\">\n73:               {{ t('defaultProjectPath') }}\n74:             </Label>\n75:             <p class=\"text-xs text-gray-500 dark:text-gray-400\">\n76:               {{ t('defaultLocationDesc') }}\n77:             </p>\n78:           </div>\n79:         </div>\n80:         <Input\n81:           v-model=\"localSettings.defaultProjectPath\"\n82:           type=\"text\"\n83:           :placeholder=\"t('defaultProjectPathPlaceholder')\"\n84:         />\n85:       </div>\n86: \n87:       <div class=\"border-t border-gray-200 dark:border-gray-700\" />\n88: \n89:       <!-- Keyboard Hints -->\n90:       <div class=\"flex items-center justify-between\">\n91:         <div class=\"flex items-center gap-3\">\n92:           <div\n93:             class=\"w-10 h-10 rounded-lg bg-orange-50 dark:bg-orange-900/20 flex items-center justify-center\"\n94:           >\n95:             <Keyboard class=\"w-5 h-5 text-orange-600 dark:text-orange-400\" />\n96:           </div>\n97:           <div>\n98:             <Label class=\"text-sm font-semibold text-gray-700 dark:text-gray-300\">\n99:               {{ t('showKeyboardHints') }}\n100:             </Label>\n101:             <p class=\"text-xs text-gray-500 dark:text-gray-400\">\n102:               {{ t('displayKeyboardShortcuts') }}\n103:             </p>\n104:           </div>\n105:         </div>\n106:         <Switch\n107:           :model-value=\"localSettings.showKeyboardHints\"\n108:           @update:model-value=\"(val) => (localSettings.showKeyboardHints = val)\"\n109:         />\n110:       </div>\n111: \n112:       <!-- Save Button -->\n113:       <div class=\"pt-4\">\n114:         <Button class=\"w-full\" @click=\"saveSettings\">\n115:           <Check class=\"w-4 h-4 mr-2\" />\n116:           {{ t('saveBtn') }}\n117:         </Button>\n118:       </div>\n119:     </div>\n120:   </div>\n121:   <SuccessModal\n122:     :visible=\"showSuccessModal\"\n123:     :title=\"t('settings.successTitle')\"\n124:     :message=\"t('settings.successMessage')\"\n125:     @close=\"showSuccessModal = false\"\n126:   />\n127: </template>\n128: \n129: <script setup>\n130: import { ref } from 'vue'\n131: import { useI18n } from 'vue-i18n'\n132: import { useDarkMode } from '@/composables/useDarkMode'\n133: import { useSettings } from '@/composables/useSettings'\n134: import { Languages, Moon, Sun, Folder, Keyboard, Check } from 'lucide-vue-next'\n135: import { Input } from '@/components/ui/input'\n136: import { Label } from '@/components/ui/label'\n137: import { Button } from '@/components/ui/button'\n138: import { Switch } from '@/components/ui/switch'\n139: import CustomSelect from '@/components/common/CustomSelect.vue'\n140: import SuccessModal from '@/components/common/SuccessModal.vue'\n141: \n142: const { t, locale } = useI18n()\n143: const { isDark, toggleDarkMode } = useDarkMode()\n144: const { settings, updateSetting } = useSettings()\n145: \n146: const currentLanguage = ref(locale.value)\n147: const localSettings = ref({ ...settings.value })\n148: const showSuccessModal = ref(false)\n149: \n150: const languageOptions = [\n151:   { value: 'km', label: 'ភាសាខ្មែរ (Khmer)' },\n152:   { value: 'en', label: 'English' },\n153: ]\n154: \n155: const changeLanguage = () => {\n156:   locale.value = currentLanguage.value\n157:   updateSetting('language', currentLanguage.value)\n158: }\n159: \n160: const saveSettings = () => {\n161:   Object.keys(localSettings.value).forEach((key) => {\n162:     updateSetting(key, localSettings.value[key])\n163:   })\n164:   showSuccessModal.value = true\n165: }\n166: </script>\n\n(End of file - total 166 lines)\n</content>","title":"src/renderer/src/components/settings/PreferenceSettings.vue","metadata":{"preview":"<template>\n  <div\n    class=\"bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700\"\n  >\n    <div\n      class=\"px-6 py-4 bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700\"\n    >\n      <h2 class=\"text-lg font-semibold text-gray-900 dark:text-white\">\n        {{ t('settingsTitle') }}\n      </h2>\n    </div>\n\n    <div class=\"p-6 space-y-5\">\n      <!-- Language -->\n      <div>\n        <div class=\"flex items-center gap-3 mb-2\">\n          <div\n            class=\"w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center\"\n         