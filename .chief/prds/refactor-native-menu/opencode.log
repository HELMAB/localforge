   <div class=\"mb-6\">\n190:             <div class=\"flex items-center justify-between mb-4\">\n191:               <div>\n192:                 <h2 class=\"text-2xl font-bold text-foreground mb-1\">\n193:                   {{ t('nginxManageVirtualHosts') }}\n194:                 </h2>\n195:                 <p class=\"text-sm text-muted-foreground\">\n196:                   {{ t('nginxManageVirtualHostsDesc') }}\n197:                 </p>\n198:               </div>\n199:               <button\n200:                 :disabled=\"isLoading\"\n201:                 class=\"px-4 py-2 bg-primary text-primary-foreground rounded-xl hover:bg-primary/90 disabled:opacity-50 transition-colors flex items-center gap-2 font-semibold\"\n202:                 @click=\"loadConfigs\"\n203:               >\n204:                 <RefreshCw class=\"h-5 w-5\" />\n205:                 {{ t('refresh') }}\n206:               </button>\n207:             </div>\n208: \n209:             <!-- Search and Filters -->\n210:             <div class=\"space-y-3\">\n211:               <!-- Search Box -->\n212:               <div class=\"relative\">\n213:                 <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\n214:                   <Search class=\"h-5 w-5 text-gray-400\" />\n215:                 </div>\n216:                 <input\n217:                   v-model=\"searchQuery\"\n218:                   type=\"text\"\n219:                   class=\"w-full pl-10 pr-4 py-2.5 border border-border rounded-xl bg-background/40 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors\"\n220:                   :placeholder=\"locale === 'km' ? 'ស្វែងរកគេហទំព័រ...' : 'Search sites...'\"\n221:                 />\n222:               </div>\n223: \n224:               <!-- Filter Buttons -->\n225:               <div class=\"flex flex-wrap gap-2\">\n226:                 <!-- Status Filters -->\n227:                 <di