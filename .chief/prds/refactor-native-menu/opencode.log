p>\n36:               </div>\n37:               <button\n38:                 v-if=\"editMode\"\n39:                 class=\"px-4 py-2 text-muted-foreground hover:bg-background/50 rounded-xl transition-colors\"\n40:                 @click=\"cancelEdit\"\n41:               >\n42:                 {{ locale === 'km' ? 'បោះបង់' : 'Cancel' }}\n43:               </button>\n44:             </div>\n45:           </div>\n46: \n47:           <!-- Project Type Selector -->\n48:           <div>\n49:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">\n50:               {{ t('nginxProjectTypeLabel') }} <span class=\"text-red-500\">*</span>\n51:             </label>\n52:             <CustomSelect v-model=\"projectType\" :options=\"projectTypeOptions\" />\n53:           </div>\n54: \n55:           <!-- Domain Name -->\n56:           <div>\n57:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">\n58:               {{ t('domainLabel') }} <span class=\"text-red-500\">*</span>\n59:             </label>\n60:             <input\n61:               v-model=\"domain\"\n62:               type=\"text\"\n63:               :placeholder=\"locale === 'km' ? 'myapp.local' : 'myapp.local'\"\n64:               :class=\"[\n65:                 'w-full px-4 py-2 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 transition-colors',\n66:                 validationErrors.domain\n67:                   ? 'border-red-500 focus:ring-red-500'\n68:                   : 'border-gray-300 dark:border-gray-600 focus:ring-blue-500',\n69:               ]\"\n70:               @blur=\"validateDomain\"\n71:             />\n72:             <div\n73:               v-if=\"validationErrors.domain\"\n74:               class=\"flex items-start gap-1.5 mt-1.5 p-2 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md\"\n75:             >\n76:               <AlertCircle class=\"h-4 w-4 text-red-500 dark:text-red-400 flex-shrink-0 mt-0.5\" />\n77:               <p class=\"text-red-700 dark:text-red-300 text-xs leading-tight\">\n78:                 {{ validationErrors.domain }}\n79:               </p>\n80:             </div>\n81:           </div>\n82: \n83:           <!-- Project Path -->\n84:           <div>\n85:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">\n86:               {{ t('nginxPathLabel') }} <span class=\"text-red-500\">*</span>\n87:             </label>\n88:             <DirectorySelector v-model=\"nginxProjectPath\" @update:model-value=\"validatePath\" />\n89:             <div\n90:               v-if=\"validationErrors.path\"\n91:               class=\"flex items-start gap-1.5 mt-1.5 p-2 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md\"\n92:             >\n93:               <AlertCircle class=\"h-4 w-4 text-red-500 dark:text-red-400 flex-shrink-0 mt-0.5\" />\n94:               <p class=\"text-red-700 dark:text-red-300 text-xs leading-tight\">\n95:                 {{ validationErrors.path }}\n96:               </p>\n97:             </div>\n98:           </div>\n99: \n100:           <!-- PHP Version (only for PHP, Laravel, and WordPress projects) -->\n101:           <div v-if=\"['php', 'laravel', 'wordpress'].includes(projectType)\">\n102:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">{{\n103:               t('nginxPhpVersionLabel')\n104:             }}</label>\n105:             <CustomSelect\n106:               v-model=\"phpVersion\"\n107:               :options=\"phpVersionOptions\"\n108:               placeholder=\"Auto-detect (ស្វ័យប្រវត្តិ)\"\n109:             />\n110:             <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-2\">\n111:               {{\n112:                 locale === 'km'\n113:                   ? 'ប្រព័ន្ធនឹងស្វែងរក PHP-FPM socket ដែលមាននៅក្នុងថត /run/php/ ដោយស្វ័យប្រវត្តិ។'\n114:                   : 'The syste