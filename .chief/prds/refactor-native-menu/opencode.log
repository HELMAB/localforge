4: \n305:                 <!-- Results count -->\n306:                 <div\n307:                   v-if=\"filteredConfigs.length !== configs.length\"\n308:                   class=\"flex items-center px-3 py-1.5 text-sm text-muted-foreground bg-background/35 border border-border/60 rounded-xl backdrop-blur-xl\"\n309:                 >\n310:                   {{ locale === 'km' ? 'បង្ហាញ' : 'Showing' }} {{ filteredConfigs.length }}\n311:                   {{ locale === 'km' ? 'ក្នុងចំណោម' : 'of' }} {{ configs.length }}\n312:                 </div>\n313:               </div>\n314:             </div>\n315:           </div>\n316: \n317:           <!-- Loading State -->\n318:           <div\n319:             v-if=\"isLoading\"\n320:             class=\"flex flex-col items-center justify-center py-16 text-muted-foreground\"\n321:           >\n322:             <div class=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary mb-4\" />\n323:             <p>{{ t('loading') }}...</p>\n324:           </div>\n325: \n326:           <!-- Empty State -->\n327:           <div\n328:             v-else-if=\"filteredConfigs.length === 0 && configs.length === 0\"\n329:             class=\"flex flex-col items-center justify-center py-16 text-gray-500 dark:text-gray-400\"\n330:           >\n331:             <FileText class=\"h-20 w-20 mb-4 text-gray-400\" />\n332:             <p class=\"text-lg font-medium mb-2\">\n333:               {{ t('nginxNoConfigs') }}\n334:             </p>\n335:             <p class=\"text-sm text-gray-500 dark:text-gray-400 mb-6\">\n336:               {{ t('nginxNoConfigsDesc') }}\n337:             </p>\n338:             <button\n339:               class=\"px-6 py-2.5 bg-blue-500 dark:bg-blue-600 text-white rounded-lg hover:bg-blue-600 dark:hover:bg-blue-700 transition-colors font-medium\"\n340:               @click=\"activeMenu = 'new-site'\"\n341:             >\n342:               {{ t('nginxCreateFirst') }}\n343:             </button>\n344:           </div>\n345: \n346:           <!-- No Results State -->\n347:           <div\n348:             v-else-if=\"filteredConfigs.length === 0 && configs.length > 0\"\n349:             class=\"flex flex-col items-center justify-center py-16 text-gray-500 dark:text-gray-400\"\n350:           >\n351:             <SearchX class=\"h-20 w-20 mb-4 text-gray-400\" />\n352:             <p class=\"text-lg font-medium mb-2\">\n353:               {{ locale === 'km' ? 'រកមិនឃើញលទ្ធផល' : 'No results found' }}\n354:             </p>\n355:             <p class=\"text-sm text-gray-500 dark:text-gray-400 mb-6\">\n356:               {{\n357:                 locale === 'km'\n358:                   ? 'សូមព្យាយាមផ្លាស់ប្តូរការស្វែងរក ឬតម្រង'\n359:                   : 'Try adjusting your search or filters'\n360:               }}\n361:             </p>\n362:             <button\n363:               class=\"px-4 py-2 bg-blue-500 dark:bg-blue-600 text-white rounded-lg hover:bg-blue-600 dark:hover:bg-blue-700 transition-colors text-sm\"\n364:               @click=\"clearFilters\"\n365:             >\n366:               {{ locale === 'km' ? 'សម្អាតតម្រង' : 'Clear Filters' }}\n367:             </button>\n368:           </div>\n369: \n370:           <!-- Active Sites -->\n371:           <div v-else class=\"space-y-6\">\n372:             <!-- Active Sites with HTTPS -->\n373:             <div\n374:               v-if=\"activeSitesWithSSL.length > 0\"\n375:               class=\"bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg p-4\"\n376:             >\n377:               <h4\n378:                 class=\"font-semibold text-green-800 dark:text-green-300 mb-3 flex items-center gap-2\"\n379:               >\n380:                 <Lock class=\"h-5 w-5\" />\n381:                 {{ locale === 'km' ? 'គេហទំព័រសកម្ម (មាន HTTPS)' : 'Active Sites (HTTPS)' }}\n382:                 <span\n383:                   class=\"ml-auto px-2 py-0.5 text-xs bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 rounded-full\"\n384:                 >\n385:                   {{ activeSitesWithSSL.length }}\n386:                 </span>\n387:               </h4>\n388:               <div class=\"space-y-2\">\n389:                 <div\n390:                   v-for=\"config in activeSitesWithSSL\"\n391:                   :key=\"config.name\"\n392:                   class=\"bg-white dark:bg-gray-800 rounded-lg border border-green-300 dark:border-green-700 overflow-hidden transition-all hover:shadow-md\"\n393:                 >\n394:                   <!-- Site Card Header -->\n395:                   <div class=\"flex items-center justify-between p-4\">\n396:                     <button\n397:                       class=\"flex-1 min-w-0 text-left\"\n398:                       @click=\"toggleSiteDetails(config.name)\"\n399:                     >\n400:                       <div class=\"flex items-center gap-2 mb-1\">\n401:                         <button\n402:                           class=\"p-1 hover:bg-gray-100 dark:hover:bg-gray-700 rounded transition-colors\"\n403:                           :title=\"\n404:                             isFavorite('nginxConfigs', config.name)\n405:                               ? locale === 'km'\n406:                                 ? 'ដកចេញពីចំណូលចិត្ត'\n407:                                 : 'Remove from favorites'\n408:                               : locale === 'km'\n409:                                 ? 'បន្ថែមទៅចំណូលចិត្ត'\n410:                                 : 'Add to favorites'\n411:                           \"\n412:                           @click.stop=\"\n413:                             toggleFavorite('nginxConfigs', {\n414:                               id: config.name,\n415:                               name: config.name,\n416:                               path: config.path,\n417:                               type: 'nginx',\n418:                             })\n419:                           \"\n420:                         >\n421:                           <Star\n422:                             class=\"h-4 w-4\"\n423:                             :class=\"\n424:                               isFavorite('nginxConfigs', config.name)\n425:                                 ? 'text-yellow-400'\n426:                                 : 'text-gray-400'\n427:                             \"\n428:                             :fill=\"\n429:                               isFavorite('nginxConfigs', config.name) ? 'currentColor' : 'none'\n430:                             \"\n431:                           />\n432:                         </button>\n433:                         <ChevronRight\n434:                           :class=\"[\n435:                             'h-4 w-4 text-gray-500 dark:text-gray-400 transition-transform flex-shrink-0',\n436:                             { 'rotate-90': expandedSite === config.name },\n437:                           ]\"\n438:                         />\n439:                         <Code2 class=\"h-5 w-5 text-green-600 dark:text-green-400 flex-shrink-0\" />\n440:                         <span class=\"font-semibold text-green-700 dark:text-green-400 truncate\">{{\n441:                           config.name\n442:                         }}</span>\n443:                         <span\n444:                           class=\"px-2 py-0.5 text-xs bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 rounded flex-shrink-0\"\n445:                         >\n446:                           {{ t('active') }}\n447:                         </span>\n448:                         <span\n449:                           v-if=\"config.hasSSL\"\n450:                           class=\"px-2 py-0.5 text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 rounded flex items-center gap-1 flex-shrink-0\"\n451:                           :title=\"locale === 'km' ? 'មាន SSL/HTTPS' : 'SSL/HTTPS Enabled'\"\n452:                   