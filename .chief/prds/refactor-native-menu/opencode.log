('php'),\n113:               click: () => mainWindow.webContents.send('navigate', '/services', 'php'),\n114:             },\n115:             {\n116:               label: tr('composer'),\n117:               click: () => mainWindow.webContents.send('navigate', '/services', 'composer'),\n118:             },\n119:             {\n120:               label: tr('nodejs'),\n121:               click: () => mainWindow.webContents.send('navigate', '/services', 'node'),\n122:             },\n123:             {\n124:               label: tr('nginx'),\n125:               click: () => mainWindow.webContents.send('navigate', '/services', 'nginx'),\n126:             },\n127:             {\n128:               label: tr('postgresql'),\n129:               click: () => mainWindow.webContents.send('navigate', '/services', 'postgresql'),\n130:             },\n131:             {\n132:               label: tr('mysql'),\n133:               click: () => mainWindow.webContents.send('navigate', '/services', 'mysql'),\n134:             },\n135:           ],\n136:         },\n137:         { type: 'separator' },\n138:         {\n139:           label: tr('preferences'),\n140:           accelerator: 'CmdOrCtrl+,',\n141:           click: () => mainWindow.webContents.send('navigate', '/settings'),\n142:         },\n143:         { type: 'separator' },\n144:         isMac ? { label: tr('close'), role: 'close' } : { label: tr('quit'), role: 'quit' },\n145:       ],\n146:     },\n147:     // Window menu\n148:     {\n149:       label: tr('window'),\n150:       submenu: [\n151:         { role: 'reload' },\n152:         { role: 'toggleDevTools' },\n153:         { type: 'separator' },\n154:         { role: 'minimize' },\n155:         { type: 'separator' },\n156:         {\n157:           label: tr('about'),\n158:           click: () => mainWindow.webContents.send('show-about'),\n159:         },\n160:       ],\n161:     },\n162:     // Help menu\n163:     {\n164:       label: tr('help'),\n165:       submenu: [\n166:         {\n167:           label: tr('restartApp'),\n168:           click: () => {\n169:             mainWindow.webContents.send('restart-app')\n170:           },\n171:         },\n172:         {\n173:           label: tr('checkUpdates'),\n174:           click: () => {\n175:             mainWindow.webContents.send('check-updates')\n176:           },\n177:         },\n178:       ],\n179:     },\n180:   ]\n181: \n182:   const menu = Menu.buildFromTemplate(template)\n183:   Menu.setApplicationMenu(menu)\n184: }\n185: \n186: function rebuildMenu(mainWindow, state) {\n187:   if (state.language !== undefined) {\n188:     language = state.language\n189:   }\n190:   buildMenu(mainWindow)\n191: }\n192: \n193: module.exports = { buildMenu, rebuildMenu }\n\n(End of file - total 193 lines)\n</content>","title":"src/main/menu.js","metadata":{"preview":"const { Menu } = require('electron')\n\nlet language = 'km'\n\nconst translations = {\n  km: {\n    file: 'ឯកសារ',\n    projects: 'គម្រោង',\n    newProject: 'គម្រោងថ្មី',\n    listProjects: 'បង្ហាញគម្រោង',\n    importProject: 'នាំចូលគម្រោង',\n    virtualHosts: 'Virtual Host',\n    newVirtualHost: 'Virtual Host ថ្មី',\n    manageSites: 'គ្រប់គ្រងតំបន់',\n    services: 'សេវាកម្ម',\n    php: 'PHP',\n    composer: 'Composer',\n    nodejs: 'Node.js',\n    nginx: 'Nginx',\n    postgresql: 'PostgreSQL',","truncated":false,"loaded":[]},"time":{"start":1773233070012,"end":1773233070034}}}}
