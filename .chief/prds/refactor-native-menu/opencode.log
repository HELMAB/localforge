p>\n36:               </div>\n37:               <button\n38:                 v-if=\"editMode\"\n39:                 class=\"px-4 py-2 text-muted-foreground hover:bg-background/50 rounded-xl transition-colors\"\n40:                 @click=\"cancelEdit\"\n41:               >\n42:                 {{ locale === 'km' ? 'បោះបង់' : 'Cancel' }}\n43:               </button>\n44:             </div>\n45:           </div>\n46: \n47:           <!-- Project Type Selector -->\n48:           <div>\n49:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">\n50:               {{ t('nginxProjectTypeLabel') }} <span class=\"text-red-500\">*</span>\n51:             </label>\n52:             <CustomSelect v-model=\"projectType\" :options=\"projectTypeOptions\" />\n53:           </div>\n54: \n55:           <!-- Domain Name -->\n56:           <div>\n57:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">\n58:               {{ t('domainLabel') }} <span class=\"text-red-500\">*</span>\n59:             </label>\n60:             <input\n61:               v-model=\"domain\"\n62:               type=\"text\"\n63:               :placeholder=\"locale === 'km' ? 'myapp.local' : 'myapp.local'\"\n64:               :class=\"[\n65:                 'w-full px-4 py-2 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 transition-colors',\n66:                 validationErrors.domain\n67:                   ? 'border-red-500 focus:ring-red-500'\n68:                   : 'border-gray-300 dark:border-gray-600 focus:ring-blue-500',\n69:               ]\"\n70:               @blur=\"validateDomain\"\n71:             />\n72:             <div\n73:               v-if=\"validationErrors.domain\"\n74:               class=\"flex items-start gap-1.5 mt-1.5 p-2 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md\"\n75:             >\n76:               <AlertCircle class=\"h-4 w-4 text-red-500 dark:text-red-400 flex-shrink-0 mt-0.5\" />\n77:               <p class=\"text-red-700 dark:text-red-300 text-xs leading-tight\">\n78:                 {{ validationErrors.domain }}\n79:               </p>\n80:             </div>\n81:           </div>\n82: \n83:           <!-- Project Path -->\n84:           <div>\n85:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">\n86:               {{ t('nginxPathLabel') }} <span class=\"text-red-500\">*</span>\n87:             </label>\n88:             <DirectorySelector v-model=\"nginxProjectPath\" @update:model-value=\"validatePath\" />\n89:             <div\n90:               v-if=\"validationErrors.path\"\n91:               class=\"flex items-start gap-1.5 mt-1.5 p-2 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md\"\n92:             >\n93:               <AlertCircle class=\"h-4 w-4 text-red-500 dark:text-red-400 flex-shrink-0 mt-0.5\" />\n94:               <p class=\"text-red-700 dark:text-red-300 text-xs leading-tight\">\n95:                 {{ validationErrors.path }}\n96:               </p>\n97:             </div>\n98:           </div>\n99: \n100:           <!-- PHP Version (only for PHP, Laravel, and WordPress projects) -->\n101:           <div v-if=\"['php', 'laravel', 'wordpress'].includes(projectType)\">\n102:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">{{\n103:               t('nginxPhpVersionLabel')\n104:             }}</label>\n105:             <CustomSelect\n106:               v-model=\"phpVersion\"\n107:               :options=\"phpVersionOptions\"\n108:               placeholder=\"Auto-detect (ស្វ័យប្រវត្តិ)\"\n109:             />\n110:             <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-2\">\n111:               {{\n112:                 locale === 'km'\n113:                   ? 'ប្រព័ន្ធនឹងស្វែងរក PHP-FPM socket ដែលមាននៅក្នុងថត /run/php/ ដោយស្វ័យប្រវត្តិ។'\n114:                   : 'The system will automatically search for available PHP-FPM sockets in /run/php/.'\n115:               }}\n116:             </p>\n117:           </div>\n118: \n119:           <!-- Port -->\n120:           <div>\n121:             <label class=\"block text-sm font-medium mb-2 dark:text-gray-300\">{{\n122:               t('portLabel')\n123:             }}</label>\n124:             <input\n125:               v-model.number=\"port\"\n126:               type=\"number\"\n127:               placeholder=\"3000\"\n128:               class=\"w-full px-4 py-2 border dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n129:             />\n130:           </div>\n131: \n132:           <!-- Enable SSL Toggle -->\n133:           <div>\n134:             <div\n135:               class=\"flex items-center justify-between p-4 border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-900 transition-all hover:border-blue-300 dark:hover:border-blue-600\"\n136:             >\n137:               <div class=\"flex-1\">\n138:                 <label\n139:                   class=\"flex items-center gap-2 text-sm font-medium text-gray-900 dark:text-gray-100 cursor-pointer\"\n140:                 >\n141:                   <Lock class=\"h-5 w-5 text-green-600 dark:text-green-400\" />\n142:                   {{ t('enableSSL') }}\n143:                 </label>\n144:                 <p class=\"text-xs text-gray-600 dark:text-gray-400 mt-1 ml-7\">\n145:                   {{ t('enableSSLDesc') }}\n146:                 </p>\n147:               </div>\n148:               <label class=\"relative inline-flex items-center cursor-pointer\">\n149:                 <input v-model=\"enableSSL\" type=\"checkbox\" class=\"sr-only peer\" />\n150:                 <div\n151:                   class=\"w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600\"\n152:                 />\n153:               </label>\n154:             </div>\n155:             <p v-if=\"enableSSL\" class=\"text-xs text-orange-600 dark:text-orange-400 mt-2\">\n156:               {{\n157:                 locale === 'km'\n158:                   ? 'ត្រូវការ mkcert។ ប្រសិនបើមិនទាន់បានដំឡើង៖ sudo apt install mkcert'\n159:                   : 'Requires mkcert. If not installed: sudo apt install mkcert'\n160:               }}\n161:             </p>\n162:           </div>\n163: \n164:           <button\n165:             :disabled=\"isConfiguring\"\n166:             class=\"w-full px-6 py-3 bg-primary text-primary-foreground rounded-xl hover:bg-primary/90 font-semibold disabled:opacity-50 disabled:cursor-not-allowed transition-colors\"\n167:             @click=\"handleConfigureNginx\"\n168:           >\n169:             <span v-if=\"isConfiguring\">{{ t('checking') }}</span>\n170:             <span v-else-if=\"editMode\">{{\n171:               locale === 'km' ? 'ធ្វើបច្ចុប្បន្នភាព' : 'Update Configuration'\n172:             }}</span>\n173:             <span v-else>{{ t('configureBtn') }}</span>\n174:           </button>\n175: \n176:           <AlertNotification\n177:             :message=\"status.message.value\"\n178:             :type=\"status.type.value\"\n179:             :visible=\"status.visible.value\"\n180:             @close=\"status.hideStatus\"\n181:           />\n182:         </div>\n183:       </div>\n184: \n185:       <!-- Sites List -->\n186:       <div v-else-if=\"activeMenu === 'sites'\" class=\"p-4 sm:p-6 overflow-y-auto h-full\">\n187:         <div class=\"space-y-6\">\n188:           <!-- Header -->\n189:           <div class=\"mb-6\">\n190:             <div class=\"flex items-center justify-between mb-4\">\n191:               <div>\n192:                 <h2 class=\"text-2xl font-bold text-foreground mb-1\">\n193:                   {{ t('nginxManageVirtualHosts') }}\n194:                 </h2>\n195:                 <p class=\"text-sm text-muted-foreground\">\n196:                   {{ t('nginxManageVirtualHostsDesc') }}\n197:                 </p>\n198:               </div>\n199:               <button\n200:                 :disabled=\"isLoading\"\n201:                 class=\"px-4 py-2 bg-primary text-primary-foreground rounded-xl hover:bg-primary/90 disabled:opacity-50 transition-colors flex items-center gap-2 font-semibold\"\n202:                 @click=\"loadConfigs\"\n203:               >\n204:                 <RefreshCw class=\"h-5 w-5\" />\n205:                 {{ t('refresh') }}\n206:               </button>\n207:             </div>\n208: \n209:             <!-- Search and Filters -->\n210:             <div class=\"space-y-3\">\n211:               <!-- Search Box -->\n212:               <div class=\"relative\">\n213:                 <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\n214:                   <Search class=\"h-5 w-5 text-gray-400\" />\n215:                 </div>\n216:                 <input\n217:                   v-model=\"searchQuery\"\n218:                   type=\"text\"\n219:                   class=\"w-full pl-10 pr-4 py-2.5 border border-border rounded-xl bg-background/40 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors\"\n220:                   :placeholder=\"locale === 'km' ? 'ស្វែងរកគេហទំព័រ...' : 'Search sites...'\"\n221:                 />\n222:               </div>\n223: \n224:               <!-- Filter Buttons -->\n225:               <div class=\"flex flex-wrap gap-2\">\n226:                 <!-- Status Filters -->\n227:                 <div\n228:                   class=\"flex gap-1 bg-background/35 border border-border/60 p-1 rounded-xl backdrop-blur-xl\"\n229:                 >\n230:                   <button\n231:                     :class=\"[\n232:                       'px-3 py-1.5 text-sm font-semibold rounded-lg transition-colors',\n233:                       statusFilter === 'all'\n234:                         ? 'bg-background/60 text-foreground shadow-sm'\n235:                         : 'text-muted-foreground hover:text-foreground',\n236:                     ]\"\n237:                     @click=\"statusFilter = 'all'\"\n238:                   >\n239:                     {{ locale === 'km' ? 'ទាំងអស់' : 'All' }}\n240:                   </button>\n241:                   <button\n242:                     :class=\"[\n243:                       'px-3 py-1.5 text-sm font-semibold rounded-lg transition-colors',\n244:                       statusFilter === 'active'\n245:                         ? 'bg-background/60 text-green-700 dark:text-green-400 shadow-sm'\n246:                         : 'text-muted-foreground hover:text-foreground',\n247:                     ]\"\n248:                     @click=\"statusFilter = 'active'\"\n249:                   >\n250:                     {{ t('active') }}\n251:                   </button>\n252:                   <button\n253:                     :class=\"[\n254:                       'px-3 py-1.5 text-sm font-semibold rounded-lg transition-colors',\n255:                       statusFilter === 'inactive'\n256:                         ? 'bg-background/60 text-foreground/80 shadow-sm'\n257:                         : 'text-muted-foreground hover:text-foreground',\n258:                     ]\"\n259:                     @click=\"statusFilter = 'inactive'\"\n260:                   >\n261:                     {{ t('inactive') }}\n262:                   </button>\n263:                 </div>\n264: \n265:                 <!-- SSL Filters -->\n266:                 <div\n267:                   class=\"flex gap-1 bg-background/35 border border-border/60 p-1 rounded-xl backdrop-blur-xl\"\n268:                 >\n269:                   <button\n270:                     :class=\"[\n271:                       'px-3 py-1.5 text-sm font-semibold rounded-lg transition-colors',\n272:                       sslFilter === 'all'\n273:                         ? 'bg-background/60 text-foreground shadow-sm'\n274:                         : 'text-muted-foreground hover:text-foreground',\n275:                     ]\"\n276:                     @click=\"sslFilter = 'all'\"\n277:                   >\n278:                     {{ locale === 'km' ? 'ទាំងអស់' : 'All' }}\n279:                   </button>\n280:                   <button\n281:                     :class=\"[\n282:                       'px-3 py-1.5 text-sm font-semibold rounded-lg transition-colors flex items-center gap-1',\n283:                       sslFilter === 'https'\n284:                         ? 'bg-background/60 text-primary shadow-sm'\n285:                         : 'text-muted-foreground hover:text-foreground',\n286:                     ]\"\n287:                     @click=\"sslFilter = 'https'\"\n288:                   >\n289:                     <Lock class=\"h-3.5 w-3.5\" />\n290:                     HTTPS\n291:                   </button>\n292:                   <button\n293:                     :class=\"[\n294:                       'px-3 py-1.5 text-sm font-semibold rounded-lg transition-colors',\n295:                       sslFilter === 'no-https'\n296:                         ? 'bg-background/60 text-yellow-700 dark:text-yellow-400 shadow-sm'\n297:                         : 'text-muted-foreground hover:text-foreground',\n298:                     ]\"\n299:                     @click=\"sslFilter = 'no-https'\"\n300:                   >\n301:                     {{ locale === 'km' ? 'គ្មាន HTTPS' : 'No HTTPS' }}\n302:                   </button>\n303:                 </div>\n304: \n305:                 <!-- Results count -->\n306:                 <div\n307:                   v-if=\"filteredConfigs.length !== configs.length\"\n308:                   class=\"flex items-center px-3 py-1.5 text-sm text-muted-foreground bg-background/35 border border-border/60 rounded-xl backdrop-blur-xl\"\n309:                 >\n310:                   {{ locale === 'km' ? 'បង្ហាញ' : 'Showing' }} {{ filteredConfigs.length }}\n311:                   {{ locale === 'km' ? 'ក្នុងចំណោម' : 'of' }} {{ configs.length }}\n312:                 </div>\n313:               </div>\n314:             </div>\n315:           </div>\n316: \n317:           <!-- Loading State -->\n318:           <div\n319:             v-if=\"isLoading\"\n320:             class=\"flex flex-col items-center justify-center py-16 text-muted-foreground\"\n321:           >\n322:             <div class=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary mb-4\" />\n323:             <p>{{ t('loading') }}...</p>\n324:           </div>\n325: \n326:           <!-- Empty State -->\n327:           <div\n328:             v-else-if=\"filteredConfigs.length === 0 && configs.length === 0\"\n329:             class=\"flex flex-col items-center justify-center py-16 text-gray-500 dark:text-gray-400\"\n330:           >\n331:             <FileText class=\"h-20 w-20 mb-4 text-gray-400\" />\n332:             <p class=\"text-lg font-medium mb-2\">\n333:               {{ t('nginxNoConfigs') }}\n334:             </p>\n335:             <p class=\"text-sm text-gray-500 dark:text-gray-400 mb-6\">\n336:               {{ t('nginxNoConfigsDesc') }}\n337:             </p>\n338:             <button\n339:               class=\"px-6 py-2.5 bg-blue-500 dark:bg-blue-600 text-white rounded-lg hover:bg-blue-600 dark:hover:bg-blue-700 transition-colors font-medium\"\n340:               @click=\"activeMenu = 'new-site'\"\n341:             >\n342:               {{ t('nginxCreateFirst') }}\n343:             </button>\n344:           </div>\n345: \n346:           <!-- No Results State -->\n347:           <div\n348:             v-else-if=\"filteredConfigs.length === 0 && configs.length > 0\"\n349:             class=\"flex flex-col items-center justify-center py-16 text-gray-500 dark:text-gray-400\"\n350:           >\n351:             <SearchX class=\"h-20 w-20 mb-4 text-gray-400\" />\n352:             <p class=\"text-lg font-medium mb-2\">\n353:               {{ locale === 'km' ? 'រកមិនឃើញលទ្ធផល' : 'No results found' }}\n354:             </p>\n355:             <p class=\"text-sm text-gray-500 dark:text-gray-400 mb-6\">\n356:               {{\n357:                 locale === 'km'\n358:                   ? 'សូមព្យាយាមផ្លាស់ប្តូរការស្វែងរក ឬតម្រង'\n359:                   : 'Try adjusting your search or filters'\n360:               }}\n361:             </p>\n362:             <button\n363:               class=\"px-4 py-2 bg-blue-500 dark:bg-blue-600 text-white rounded-lg hover:bg-blue-600 dark:hover:bg-blue-700 transition-colors text-sm\"\n364:               @click=\"clearFilters\"\n365:             >\n366:               {{ locale === 'km' ? 'សម្អាតតម្រង' : 'Clear Filters' }}\n367:             </button>\n368:           </div>\n369: \n370:           <!-- Active Sites -->\n371:           <div v-else class=\"space-y-6\">\n372:             <!-- Active Sites with HTTPS -->\n373:             <div\n374:               v-if=\"activeSitesWithSSL.length > 0\"\n375:               class=\"bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg p-4\"\n376:             >\n377:               <h4\n378:                 class=\"font-semibold text-green-800 dark:text-green-300 mb-3 flex items-center gap-2\"\n379:               >\n380:                 <Lock class=\"h-5 w-5\" />\n381:                 {{ locale === 'km' ? 'គេហទំព័រសកម្ម (មាន HTTPS)' : 'Active Sites (HTTPS)' }}\n382:                 <span\n383:                   class=\"ml-auto px-2 py-0.5 text-xs bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 rounded-full\"\n384:                 >\n385:                   {{ activeSitesWithSSL.length }}\n386:                 </span>\n387:               </h4>\n388:               <div class=\"space-y-2\">\n389:                 <div\n390:                   v-for=\"config in activeSitesWithSSL\"\n391:                   :key=\"config.name\"\n392:                   class=\"bg-white dark:bg-gray-800 rounded-lg border border-green-300 dark:border-green-700 overflow-hidden transition-all hover:shadow-md\"\n393:                 >\n394:                   <!-- Site Card Header -->\n395:                   <div class=\"flex items-center justify-between p-4\">\n396:                     <button\n397:                       class=\"flex-1 min-w-0 text-left\"\n398:                       @click=\"toggleSiteDetails(config.name)\"\n399:                     >\n400:                       <div class=\"flex items-center gap-2 mb-1\">\n401:                         <button\n402:                           class=\"p-1 hover:bg-gray-100 dark:hover:bg-gray-700 rounded transition-colors\"\n403:                           :title=\"\n404:                             isFavorite('nginxConfigs', config.name)\n405:                               ? locale === 'km'\n406:                                 ? 'ដកចេញពីចំណូលចិត្ត'\n407:                                 : 'Remove from favorites'\n408:                               : locale === 'km'\n409:                                 ? 'បន្ថែមទៅចំណូលចិត្ត'\n410:                                 : 'Add to favorites'\n411:                           \"\n412:                           @click.stop=\"\n413:                             toggleFavorite('nginxConfigs', {\n414:                               id: config.name,\n415:                               name: config.name,\n416:                               path: config.path,\n417:                               type: 'nginx',\n418:                             })\n419:                           \"\n420:                         >\n421:                           <Star\n422:                             class=\"h-4 w-4\"\n423:                             :class=\"\n424:                               isFavorite('nginxConfigs', config.name)\n425:                                 ? 'text-yellow-400'\n426:                                 : 'text-gray-400'\n427:                             \"\n428:                             :fill=\"\n429:                               isFavorite('nginxConfigs', config.name) ? 'currentColor' : 'none'\n430:                             \"\n431:                           />\n432:                         </button>\n433:                         <ChevronRight\n434:                           :class=\"[\n435:                             'h-4 w-4 text-gray-500 dark:text-gray-400 transition-transform flex-shrink-0',\n436:                             { 'rotate-90': expandedSite === config.name },\n437:                           ]\"\n438:                         />\n439:                         <Code2 class=\"h-5 w-5 text-green-600 dark:text-green-400 flex-shrink-0\" />\n440:                         <span class=\"font-semibold text-green-700 dark:text-green-400 truncate\">{{\n441:                           config.name\n442:                         }}</span>\n443:                         <span\n444:                           class=\"px-2 py-0.5 text-xs bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 rounded flex-shrink-0\"\n445:                         >\n446:                           {{ t('active') }}\n447:                         </span>\n448:                         <span\n449:                           v-if=\"config.hasSSL\"\n450:                           class=\"px-2 py-0.5 text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 rounded flex items-center gap-1 flex-shrink-0\"\n451:                           :title=\"locale === 'km' ? 'មាន SSL/HTTPS' : 'SSL/HTTPS Enabled'\"\n452:                   