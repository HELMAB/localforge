lIcon from '@/assets/svg/laravel.svg'\n831: import wordpressIcon from '@/assets/svg/wordpress.svg'\n832: import vueIcon from '@/assets/svg/vuejs.svg'\n833: import nuxtIcon from '@/assets/svg/nuxtjs.svg'\n834: import reactIcon from '@/assets/svg/react.svg'\n835: import htmlIcon from '@/assets/svg/html5.svg'\n836: \n837: const { t, locale } = useI18n()\n838: const {\n839:   configureNginx,\n840:   isConfiguring,\n841:   listNginxConfigs,\n842:   deleteNginxConfig,\n843:   enableNginxConfig,\n844:   disableNginxConfig,\n845:   addSslToConfig,\n846:   removeSslFromConfig,\n847:   getNginxConfigDetails,\n848:   isLoading,\n849: } = useNginx()\n850: const status = useStatus()\n851: const { installedTools, checkInstalledTools } = useTools()\n852: const { toggleFavorite, isFavorite } = useFavorites()\n853: const errorModal = inject('errorModal', null)\n854: \n855: const projectType = ref('php')\n856: const domain = ref('')\n857: const nginxProjectPath = ref('')\n858: const phpVersion = ref('')\n859: const port = ref(80)\n860: const enableSSL = ref(false)\n861: const configs = ref([])\n862: const activeMenu = ref('sites')\n863: const openDropdown = ref(null)\n864: const dropdownRefs = ref({})\n865: const dropdownPositions = ref({})\n866: const validationErrors = ref({})\n867: const expandedSite = ref(null)\n868: const searchQuery = ref('')\n869: const statusFilter = ref('all')\n870: const sslFilter = ref('all')\n871: const editMode = ref(false)\n872: const editingConfigName = ref(null)\n873: \n874: // Optimized: single-pass filtering for better performance\n875: const filteredConfigs = computed(() => {\n876:   const query = searchQuery.value?.toLowerCase()\n877: \n878:   return configs.value.filter((config) => {\n879:     // Search filter\n880:     if (\n881:       query &&\n882:       !config.name.toLowerCase().includes(query) &&\n883:       !config.path.toLowerCase().includes(query)\n884:     ) {\n885:       return false\n886:     }\n887: \n888:     // Status filter\n889:     if (statusFilter.value === 'active' && !config.enabled) return false\n890:     if (statusFilter.value === 'inactive' && config.enabled) return false\n891: \n892:     // SSL filter\n893:     if (sslFilter.value === 'https' && !config.hasSSL) return false\n894:     if (sslFilter.value === 'no-https' && config.hasSSL) return false\n895: \n896:     return true\n897:   })\n898: })\n899: \n900: // Computed properties to separate sites by status and SSL (using filtered configs)\n901: const activeSitesWithSSL = computed(() =>\n902:   filteredConfigs.value.filter((config) => config.enabled && config.hasSSL)\n903: )\n904: const activeSitesWithoutSSL = computed(() =>\n905:   filteredConfigs.value.filter((config) => config.enabled && !config.hasSSL)\n906: )\n907: const inactiveSites = computed(() => filteredConfigs.value.filter((config) => !config.enabled))\n908: \n909: onMounted(async () => {\n910:   await checkInstalledTools()\n911:   loadCachedConfigs()\n912:   await loadConfigs()\n913:   document.addEventListener('click', handleClickOutside)\n914: })\n915: \n916: onBeforeUnmount(() => {\n917:   document.removeEventListener('click', handleClickOutside)\n918: })\n919: \n920: function loadCachedConfigs() {\n921:   try {\n922:     const cached = localStorage.getItem('nginxConfigs')\n923:     if (cached) {\n924:       configs.value = JSON.parse(cached)\n925:     }\n926:   } catch (error) {\n927:     // eslint-disable-next-line no-console\n928:     console.error('Failed to load cached configs:', error)\n929:   }\n930: }\n931: \n932: function saveCachedConfigs() {\n933:   try {\n934:     localStorage.setItem('nginxConfigs', JSON.stringify(configs.value))\n935:     localStorage.setItem('nginxConfigsTimestamp', Date.now().toString())\n936:   } catch (error) {\n937:     // eslint-disable-next-line no-console\n938:     console.error('Failed to save cached configs:', error)\n939:   }\n940: }\n941: \n942: async function loadConfigs() {\n943:   try {\n944:     configs.value = await listNginxConfigs()\n945:     saveCachedConfigs()\n946:   } catch (error) {\n947:     // eslint-disable-next-line no-console\n948:     console.error('Failed to load configs:', error)\n949:   }\n950: }\n951: \n952: async function loadConfigForEdit(configName) {\n953:   closeDropdown()\n954:   try {\n955:     const details = await getNginxConfigDetails(configName)\n956: \n957:     // Populate form with existing values\n958:     domain.value = details.domain || ''\n959:     nginxProjectPath.value = details.projectPath || ''\n960:     projectType.value = details.projectType || 'php'\n961:     port.value = details.port || 80\n962:     phpVersion.value = details.phpVersion || ''\n963:     enableSSL.value = details.hasSSL || false\n964: \n965:     // Set edit mode\n966:     editMode.value = true\n967:     editingConfigName.value = configName\n968: \n969:     // Switch to new-site menu\n970:     activeMenu.value = 'new-site'\n971:   } catch (error) {\n972:     status.showStatus(\n973:       locale.value === 'km'\n974:         ? `កំហុសក្នុងការផ្ទុកការកំណត់: ${error.message}`\n975:         : `Error loading config: ${error.message}`,\n976:       'error'\n977:     )\n978:   }\n979: }\n980: \n981: function cancelEdit() {\n982:   // Reset form\n983:   domain.value = ''\n984:   nginxProjectPath.value = ''\n985:   projectType.value = 'php'\n986:   port.value = 80\n987:   phpVersion.value = ''\n988:   enableSSL.value = false\n989:   validationErrors.value = {}\n990: \n991:   // Exit edit mode\n992:   editMode.value = false\n993:   editingConfigName.value = null\n994: }\n995: \n996: async function toggleDropdown(configName) {\n997:   if (openDropdown.value === configName) {\n998:     openDropdown.value = null\n999:   } else {\n1000:     openDropdown.value = configName\n1001:     await nextTick()\n1002:     checkDropdownPosition(configName)\n1003:   }\n1004: }\n1005: \n1006: function closeDropdown() {\n1007:   openDropdown.value = null\n1008: }\n1009: \n1010: function checkDropdownPosition(configName) {\n1011:   const dropdownElement = dropdownRefs.value[configName]\n1012:   if (!dropdownElement) return\n1013: \n1014:   const rect = dropdownElement.getBoundingClientRect()\n1015:   const dropdownHeight = 250\n1016:   const spaceBelow = window.innerHeight - rect.bottom\n1017:   const spaceAbove = rect.top\n1018: \n1019:   dropdownPositions.value[configName] =\n1020:     spaceBelow < dropdownHeight && spaceAbove > spaceBelow ? 'up' : 'down'\n1021: }\n1022: \n1023: function handleClickOutside(event) {\n1024:   if (openDropdown.value) {\n1025:     const dropdownElement = dropdownRefs.value[openDropdown.value]\n1026:     if (dropdownElement && !dropdownElement.contains(event.target)) {\n1027:       closeDropdown()\n1028:     }\n1029:   }\n1030: }\n1031: \n1032: function getDropdownClasses(configName) {\n1033:   const position = dropdownPositions.value[configName]\n1034:   return position === 'up' ? 'bottom-full mb-2' : 'mt-2'\n1035: }\n1036: \n1037: function setDropdownRef(el, configName) {\n1038:   if (el) {\n1039:     dropdownRefs.value[configName] = el\n1040:   }\n1041: }\n1042: \n1043: function toggleSiteDetails(configName) {\n1044:   if (expandedSite.value === configName) {\n1045:     expandedSite.value = null\n1046:   } else {\n1047:     expandedSite.value = configName\n1048:   }\n1049: }\n1050: \n1051: function validateDomain() {\n1052:   const result = validateField(domainSchema, 'domain', domain.value)\n1053:   if (!result.valid) {\n1054:     validationErrors.value.domain = result.error\n1055:   } else {\n1056:     delete validationErrors.value.domain\n1057:   }\n1058: }\n1059: \n1060: function validatePath() {\n1061:   const result = validateField(pathSchema, 'path', nginxProjectPath.value)\n1062:   if (!result.valid) {\n1063:     validationErrors.value.path = result.error\n1064:   } else {\n1065:     delete validationErrors.value.path\n1066:   }\n1067: }\n1068: \n1069: async function handleDeleteConfig(configName) {\n1070:   closeDropdown()\n1071:   const confirmMessage =\n1072:     locale.value === 'km'\n1073:       ? `តើអ្នកប្រាកដថាចង់លុបការកំណត់រចនាសម្ព័ន្ធ \"${configName}\" មែនទេ? សកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ។`\n1074:       : `Are you sure you want to delete the configuration \"${configName}\"? This action cannot be undone.`\n1075: \n1076:   if (!confirm(confirmMessage)) {\n1077:     return\n1078:   }\n1079: \n1080:   try {\n1081:     await deleteNginxConfig(configName)\n1082:     status.showStatus(\n1083:       locale.value === 'km' ? `បានលុប ${configName} ជោគជ័យ` : `Successfully deleted ${configName}`,\n1084:       'success'\n1085:     )\n1086:     await loadConfigs()\n1087:   } catch (error) {\n1088:     status.showStatus(\n1089:       locale.value === 'km'\n1090:         ? `កំហុសក្នុងការលុប: ${error.message}`\n1091:         : `Error deleting: ${error.message}`,\n1092:       'error'\n1093:     )\n1094:   }\n1095: }\n1096: \n1097: async function handleEnableConfig(configName) {\n1098:   closeDropdown()\n1099:   try {\n1100:     await enableNginxConfig(configName)\n1101:     status.showStatus(\n1102:       locale.value === 'km'\n1103:         ? `បានបើកដំណើរការ ${configName} ជោគជ័យ`\n1104:         : `Successfully enabled ${configName}`,\n1105:       'success'\n1106:     )\n1107:     await loadConfigs()\n1108:   } catch (error) {\n1109:     status.showStatus(\n1110:       locale.value === 'km'\n1111:         ? `កំហុសក្នុងការបើកដំណើរការ: ${error.message}`\n1112:         : `Error enabling: ${error.message}`,\n1113:       'error'\n1114:     )\n1115:   }\n1116: }\n1117: \n1118: async function handleDisableConfig(configName) {\n1119:   closeDropdown()\n1120:   try {\n1121:     await disableNginxConfig(configName)\n1122:     status.showStatus(\n1123:       locale.value === 'km'\n1124:         ? `បានបិទដំណើរការ ${configName} ជោគជ័យ`\n1125:         : `Successfully disabled ${configName}`,\n1126:       'success'\n1127:     )\n1128:     await loadConfigs()\n1129:   } catch (error) {\n1130:     status.showStatus(\n1131:       locale.value === 'km'\n1132:         ? `កំហុសក្នុងការបិទដំណើរការ: ${error.message}`\n1133:         : `Error disabling: ${error.message}`,\n1134:       'error'\n1135:     )\n1136:   }\n1137: }\n1138: \n1139: async function handleAddSsl(configName) {\n1140:   closeDropdown()\n1141:   try {\n1142:     status.showStatus(\n1143:       locale.value === 'km'\n1144:         ? 'កំពុងបង្កើត SSL... (អ្នកប្រហែលជាត្រូវបញ្ចូលពាក្យសម្ងាត់)'\n1145:         : 'Adding SSL... (You may need to enter your password)',\n1146:       'info'\n1147:     )\n1148:     await addSslToConfig(configName)\n1149:     status.showStatus(\n1150:       locale.value === 'km'\n1151:         ? `បានបន្ថែម HTTPS ទៅ ${configName} ជោគជ័យ`\n1152:         : `Successfully added HTTPS to ${configName}`,\n1153:       'success'\n1154:     )\n1155:     await loadConfigs()\n1156:   } catch (error) {\n1157:     status.showStatus(\n1158:       locale.value === 'km'\n1159:         ? `កំហុសក្នុងការបន្ថែម HTTPS: ${error.message}`\n1160:         : `Error adding HTTPS: ${error.message}`,\n1161:       'error'\n1162:     )\n1163:   }\n1164: }\n1165: \n1166: async function handleRemoveSsl(configName) {\n1167:   closeDropdown()\n1168:   const confirmMessage =\n1169:     locale.value === 'km'\n1170:       ? `តើអ្នកប្រាកដថាចង់ដក HTTPS ពី \"${configName}\" មែនទេ?`\n1171:       : `Are you sure you want to remove HTTPS from \"${configName}\"?`\n1172: \n1173:   if (!confirm(confirmMessage)) {\n1174:     return\n1175:   }\n1176: \n1177:   try {\n1178:     await removeSslFromConfig(configName)\n1179:     status.showStatus(\n1180:       locale.value === 'km'\n1181:         ? `បានដក HTTPS ពី ${configName} ជោគជ័យ`\n1182:         : `Successfully removed HTTPS from ${configName}`,\n1183:       'success'\n1184:     )\n1185:     await loadConfigs()\n1186:   } catch (error) {\n1187:     status.showStatus(\n\n(Output capped at 50 KB. Showing lines 1-1187. Use offset=1188 to continue.)\n</content>","title":"src/renderer/src/view